lfcCameraAOB:
  db 8B 03 57 8B CB FF 90 94 04 00 00 5F

unregistersymbol(lfcCameraAOB)
dealloc(lfcCamMem)

lfcOutlinesAOB:
  db 39 8A 9C 4F 00 00

unregistersymbol(lfcOutlinesAOB)
dealloc(lfcOutlinesMem)

{$lua}
local function debugDisableLog(msg)
  local ok,value = pcall(function() return readInteger("lfc_debugLogs") end)
  if not ok or value ~= 1 then return end
  pcall(function()
    local f = io.open([[E:\Software\Coding\Modding\Life Is Strange Free Camera\logs\freecam-debug.log]], "a")
    if f ~= nil then
      f:write(os.date("%Y-%m-%d %H:%M:%S"), " ", msg, "\n")
      f:close()
    end
  end)
end

debugDisableLog("DISABLE requested")

local function destroyDisableList(list)
  if list ~= nil then
    for i,v in ipairs(list) do v.destroy() end
  end
end

destroyDisableList(lfcHotkeys)
lfcHotkeys = nil

if lfcInitTimer ~= nil then lfcInitTimer.destroy(); lfcInitTimer = nil end
if lfcCameraTimer ~= nil then lfcCameraTimer.destroy(); lfcCameraTimer = nil end
if lfcHudTimer ~= nil then lfcHudTimer.destroy(); lfcHudTimer = nil end

pcall(function() writeInteger("lfc_hudToggle", 0) end)
pcall(function() writeInteger("lfc_poseActive", 0) end)
pcall(function() writeInteger("LifeIsStrange.exe+1110598", 1) end)
pcall(function()
  local outbase = readInteger("lfc_outlines")
  if outbase ~= nil and outbase ~= 0 then writeInteger(outbase+0x4F9C, 1) end
end)
