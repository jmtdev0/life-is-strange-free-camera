      <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end

local logPath = [[E:\Software\Coding\Modding\Life Is Strange Free Camera\logs\freecam-debug.log]]

local function xinputLog(msg)
  pcall(function()
    local f = io.open(logPath, "a")
    if f ~= nil then
      f:write(os.date("%Y-%m-%d %H:%M:%S"), " xinput-left-stick-hook ", msg, "\n")
      f:close()
    end
  end)
end

local function byteHex(bytes, count)
  local parts = {}
  for i=1,count do table.insert(parts, string.format("%02X", bytes[i] or 0)) end
  return table.concat(parts, " ")
end

local symbols = {
  "XINPUT1_3.XInputGetState",
  "xinput1_3.XInputGetState",
  "XINPUT1_3.dll.XInputGetState",
  "xinput1_3.dll.XInputGetState",
  "xinput9_1_0.XInputGetState",
  "XINPUT9_1_0.XInputGetState",
  "xinput1_4.XInputGetState",
  "XINPUT1_4.XInputGetState"
}

local addr = nil
local symbol = nil
for _,candidate in ipairs(symbols) do
  addr = getAddressSafe(candidate)
  if addr ~= nil then
    symbol = candidate
    break
  end
end

if addr == nil then
  xinputLog("failed: XInputGetState export was not found in the game process")
  error("XInputGetState was not found. Start/attach the game first, then try again.")
end

local bytes = readBytes(addr, 8, true)
if bytes == nil then
  xinputLog(string.format("failed: could not read bytes at 0x%X", addr))
  error("Could not read XInputGetState bytes.")
end

local function u32le(b, i)
  return (b[i] or 0) + (b[i+1] or 0)*0x100 + (b[i+2] or 0)*0x10000 + (b[i+3] or 0)*0x1000000
end

local function s32le(b, i)
  local v = u32le(b, i)
  if v &gt;= 0x80000000 then v = v - 0x100000000 end
  return v
end

local patchAddr = addr
local originalCallAddr = nil
local hookLen = nil
local callMode = "gateway"

if bytes[1] == 0xE9 then
  hookLen = 5
  callMode = "direct"
  originalCallAddr = addr + 5 + s32le(bytes, 2)
elseif bytes[1] == 0xFF and bytes[2] == 0x25 then
  hookLen = 6
  callMode = "direct"
  local pointerAddress = u32le(bytes, 3)
  originalCallAddr = readInteger(pointerAddress)
elseif bytes[1] == 0x8B and bytes[2] == 0xFF and bytes[3] == 0x55 and bytes[4] == 0x8B and bytes[5] == 0xEC then
  hookLen = 5
elseif bytes[1] == 0x55 and bytes[2] == 0x8B and bytes[3] == 0xEC then
  hookLen = 5
end

if hookLen == nil or (callMode == "direct" and originalCallAddr == nil) then
  xinputLog(string.format("failed: unsupported prologue symbol=%s addr=0x%X bytes=%s", tostring(symbol), addr, byteHex(bytes, 8)))
  error("Unsupported XInputGetState prologue: " .. byteHex(bytes, 8))
end

local nop = ""
if hookLen == 6 then nop = "  nop" end

local originalBytes = "  db " .. byteHex(bytes, hookLen)
local directDefine = ""
local originalBlock = string.format([[
lfc_xinputOriginal:
%s
  jmp lfc_xinputPatch+%d
]], originalBytes, hookLen)
local originalCall = "  call lfc_xinputOriginal"

if callMode == "direct" then
  directDefine = string.format("define(lfc_xinputOriginalCall,%X)\n", originalCallAddr)
  originalBlock = string.format([[
lfc_xinputOriginal:
%s
]], originalBytes)
  originalCall = "  call lfc_xinputOriginalCall"
end

local enableScript = string.format([[
define(lfc_xinputPatch,%X)
%s
alloc(lfc_xinputHook,1024,lfc_xinputPatch)
label(lfc_xinputOriginal)
label(lfc_xinputDone)
label(lfc_xinputArrowX)
label(lfc_xinputArrowY)

lfc_xinputHook:
  push ebp
  mov ebp,esp
  push [ebp+0C]
  push [ebp+08]
%s
  test eax,eax
  jne lfc_xinputDone
  mov ecx,[ebp+0C]
  test ecx,ecx
  je lfc_xinputDone
  mov dx,word ptr [lfc_xinputArrowX]
  mov [ecx+08],dx
  mov dx,word ptr [lfc_xinputArrowY]
  mov [ecx+0A],dx
lfc_xinputDone:
  mov esp,ebp
  pop ebp
  ret 8

lfc_xinputArrowX:
  dd 0
lfc_xinputArrowY:
  dd 0

%s

lfc_xinputPatch:
  jmp lfc_xinputHook
%s

registersymbol(lfc_xinputHook)
registersymbol(lfc_xinputOriginal)
registersymbol(lfc_xinputArrowX)
registersymbol(lfc_xinputArrowY)
]], patchAddr, directDefine, originalCall, originalBlock, nop)

local disableScript = string.format([[
define(lfc_xinputPatch,%X)
lfc_xinputPatch:
%s
unregistersymbol(lfc_xinputArrowY)
unregistersymbol(lfc_xinputArrowX)
unregistersymbol(lfc_xinputOriginal)
unregistersymbol(lfc_xinputHook)
dealloc(lfc_xinputHook)
]], patchAddr, originalBytes)

local ok,err = autoAssemble(enableScript)
if not ok then
  xinputLog("failed: " .. tostring(err))
  error(err)
end

lfcXInputHookDisableScript = disableScript

if lfcXInputArrowTimer ~= nil then
  lfcXInputArrowTimer.destroy()
  lfcXInputArrowTimer = nil
end

local lastArrowStick = nil
local function setArrowStickValue(symbolName, value)
  pcall(function() writeInteger(symbolName, value) end)
end

lfcXInputArrowTimer = createTimer()
lfcXInputArrowTimer.Interval = 16
lfcXInputArrowTimer.OnTimer = function()
  local left = isKeyPressed(0x25)
  local up = isKeyPressed(0x26)
  local right = isKeyPressed(0x27)
  local down = isKeyPressed(0x28)
  local x = 0
  local y = 0

  if left and not right then
    x = -32768
  elseif right and not left then
    x = 32767
  end

  if up and not down then
    y = 32767
  elseif down and not up then
    y = -32768
  end

  setArrowStickValue("lfc_xinputArrowX", x)
  setArrowStickValue("lfc_xinputArrowY", y)

  local state = string.format("%d,%d", x, y)
  if state ~= lastArrowStick then
    lastArrowStick = state
    xinputLog(string.format("arrow-stick x=%d y=%d left=%s up=%s right=%s down=%s", x, y, tostring(left), tostring(up), tostring(right), tostring(down)))
  end
end
lfcXInputArrowTimer.Enabled = true

xinputLog("arrow-to-left-stick timer started")
xinputLog(string.format("enabled symbol=%s patch=0x%X callMode=%s originalCall=%s hookLen=%d bytes=%s", tostring(symbol), patchAddr, callMode, tostring(originalCallAddr), hookLen, byteHex(bytes, hookLen)))

